// Internals of رابط (src/ld + src/common).
digraph linker {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.35,
         label="رابط — linker architecture", labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a6fa5"];

  in    [label="inputs (command-line order)\n.o  .كائن  .مكتبة", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  magic [label="first bytes?", shape=diamond, fillcolor="#ffffff"];
  relf  [label="ELF reader\nvalidate header, bounds-check every\nsection, string and symbol"];
  rnat  [label="read_native\n.كائن → the same InObj shape;\nhidden label per PC-relative low part"];
  rlib  [label="library\nmembers kept aside"];
  inobj [label="InObj { InSec[], InSym[], interface }", shape=cylinder, fillcolor="#f0ecf8", color="#7a5aa6"];
  pull  [label="pull_members\nlink a member only if it exports\na name still needed (and _بداية)"];
  iface [label="check_interfaces\neach import's recorded hash = the\ninterface hash of that module, else\n'stale object'; no module twice"];
  res   [label="resolve_symbols\ndefinitions, duplicates, undefined;\nlinker defines _نهاية, _بداية_البيانات"];
  lay   [label="layout\nhosted: @0x10000, headers in segment 1\n--عاري: code exactly @0x80000000,\nheaders outside; data on next page"];
  rel   [label="apply_relocs\nS + A − P, fields rewritten\nBRANCH JAL CALL HI20 LO12 PCREL 32 64"];
  ent   [label="entry = _بداية\n(bare: must be the first instruction)"];
  wr    [label="ld_write\nELF header, PT_LOADs, symtab,\nsection headers, chmod +x"];
  out   [label="executable / kernel image", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  gsym  [label="GlobalSym hash table\nFNV-1a, 4096 buckets", shape=cylinder, fillcolor="#f0ecf8", color="#7a5aa6"];
  diag  [label="diag.c\nArabic link errors", fillcolor="#fdecea", color="#b5524a"];

  in -> magic;
  magic -> relf [label="ELF"]; magic -> rnat [label="كائن"]; magic -> rlib [label="مكتبة"];
  relf -> inobj; rnat -> inobj; rlib -> pull; inobj -> pull;
  pull -> iface -> res -> lay -> rel -> ent -> wr -> out;
  res -> gsym [style=dotted]; rel -> gsym [style=dotted];
  iface -> diag [style=dashed, color="#b5524a"];
  res -> diag [style=dashed, color="#b5524a"];
  rel -> diag [style=dashed, color="#b5524a"];
}
