// Internals of رابط (src/ld + src/common).
digraph linker {
  graph [rankdir=TB, fontname="Helvetica", fontsize=11, nodesep=0.3, ranksep=0.35,
         label="رابط — linker architecture", labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a6fa5"];

  in    [label="object files (command-line order)", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  read  [label="ld_read_object\nvalidate ELF header, bounds-check every\nsection, string and symbol\n→ InObj { InSec[], InSym[] }"];
  cls   [label="classify sections by name prefix\n.text* .rodata* .data* .bss* → 4 outputs\nnon-ALLOC dropped, others rejected"];
  res   [label="resolve_symbols\n1) definitions: strong vs weak, duplicates\n2) every strong undefined must be defined"];
  lay   [label="layout\ninput sections concatenated at their alignment\nsegment 1 @0x10000: headers .text .rodata\nsegment 2 next page, addr ≡ file offset (mod 4K)"];
  rel   [label="apply_relocs\nS + A − P, field cleared and rewritten\nBRANCH JAL CALL HI20 LO12 PCREL 32 64\nPCREL_LO12 → find its PCREL_HI20 by label"];
  ent   [label="entry = _بداية"];
  wr    [label="ld_write\nELF header, 1–2 PT_LOAD, contents,\nsymtab, section headers, chmod +x"];
  out   [label="executable", shape=note, fillcolor="#fff7e0", color="#b08a2e"];

  gsym  [label="GlobalSym hash table\nFNV-1a, 4096 buckets, chaining", shape=cylinder, fillcolor="#f0ecf8", color="#7a5aa6"];
  obuf  [label="out_data[4] Buf\nout_addr / out_fileoff / out_align", shape=cylinder, fillcolor="#f0ecf8", color="#7a5aa6"];
  diag  [label="diag.c\nArabic link errors", fillcolor="#fdecea", color="#b5524a"];

  in -> read -> cls -> res -> lay -> rel -> ent -> wr -> out;
  res -> gsym [style=dotted]; rel -> gsym [style=dotted];
  lay -> obuf [label="copy bytes"]; rel -> obuf [label="patch"]; wr -> obuf [style=dotted];
  read -> diag [style=dashed, color="#b5524a"];
  res -> diag [style=dashed, color="#b5524a"];
  rel -> diag [style=dashed, color="#b5524a"];
}
