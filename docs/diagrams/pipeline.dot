// The whole toolchain: tools (blue), files (yellow), runners (green), oracles (grey, dashed).
digraph pipeline {
  graph [rankdir=LR, fontname="Helvetica", fontsize=12, nodesep=0.3, ranksep=0.5,
         label="Arabic RISC-V toolchain: from غرة source to a running program", labelloc=t];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#eef3fb", color="#4a6fa5"];
  edge  [fontname="Helvetica", fontsize=9, color="#4a6fa5"];

  subgraph cluster_files_in { label="sources (UTF-8, file order: numbers least significant digit first)"; fontname="Helvetica"; fontsize=10; style="rounded,dashed"; color="#b08a2e";
    gsrc [label="program.غرة\nmodules, imports", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
    asrc [label="file.تجميع\nArabic assembly", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  }
  cc    [label="مترجم\ncompiler (C11)\nchecks the whole program,\nbuilds what is out of date", fillcolor="#d7e6fb"];
  as    [label="مجمع\nassembler (C11)", fillcolor="#d7e6fb"];
  ld    [label="رابط\nlinker (C11)", fillcolor="#d7e6fb"];
  lib   [label="محزم\nlibrary tool", fillcolor="#d7e6fb"];
  view  [label="عارض\nobject viewer", fillcolor="#d7e6fb"];

  obj   [label="X.كائن\nour object format\n+ module interface", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  elfo  [label="X.o\nELF64 relocatable\n(bridge to GNU / GCC)", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  mlib  [label="X.مكتبة\nlibrary of objects", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  exe   [label="executable\nELF64, static\n(hosted at 0x10000)", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  prog  [label="program\nour executable format\n(--برنامج, system imports\nleft for the loader)", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  fsimg [label="disk image\nمهيئ", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  kern  [label="kernel image\n--عاري: bare metal\nat 0x80000000", shape=note, fillcolor="#fff7e0", color="#b08a2e"];
  text  [label="text form\n(read-only, for people)", shape=note, fillcolor="#fff7e0", color="#b08a2e"];

  qemuu [label="qemu-riscv64\nLinux user mode", fillcolor="#e8f5e9", color="#4b8b4f"];
  qemus [label="qemu-system-riscv64\nvirt, -bios none\nour OS", fillcolor="#e8f5e9", color="#4b8b4f"];

  gsrc -> cc;
  cc -> asrc [label="one-file mode\nخرج.تجميع"];
  cc -> obj  [label="build mode\nبناء/ (assembler and\nlinker run inside)"];
  asrc -> as;
  as -> obj [label="out.كائن"];
  as -> elfo [label="out.o"];
  obj -> lib -> mlib;
  obj -> view -> text;
  obj -> ld; elfo -> ld; mlib -> ld [label="only needed\nmembers"];
  ld -> exe -> qemuu;
  ld -> kern -> qemus;
  ld -> prog -> fsimg -> qemus;

  node  [fillcolor="#f4f4f4", color="#888888"];
  edge  [style=dashed, color="#888888"];
  gnu   [label="test oracles\ntranslit.py → GNU as / GNU ld,\nelfcmp.py, execcmp.py,\nGCC interop, fuzzers"];
  as -> gnu [label="byte-identical"];
  ld -> gnu [label="same image"];
}
